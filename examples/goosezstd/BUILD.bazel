# goosezstd: a Zstandard decompressor written in Goose, tested against the
# real zstd (the BCR module, built with the same C toolchain): the zstd CLI
# compresses a set of inputs at build time, at several settings, and each
# test decodes one result with goosezstd and compares it with the input.

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//goose:defs.bzl", "goose_binary")
load(":fixtures.bzl", "ZSTD", "decompress_test", "zstd_compress", "zstd_matrix")

DECODER_SRCS = [
    "zstd/bits.goose",
    "zstd/blocks.goose",
    "zstd/frame.goose",
    "zstd/fse.goose",
    "zstd/huffman.goose",
    "zstd/xxhash.goose",
]

goose_binary(
    name = "goosezstd",
    srcs = ["cli.goose"] + DECODER_SRCS,
    goose_opts = ["-O2"],
    main = "goosezstd.goose",
)

# The same command line over the real libzstd, through extern fn: an
# interop demo, and a check that the test harness itself agrees with zstd.
goose_binary(
    name = "libzstd_demo",
    srcs = ["cli.goose"],
    c_hdrs = ["libzstd_shim.h"],
    cc_deps = ["@zstd//:zstd"],
    goose_opts = ["-O2"],
    main = "libzstd_demo.goose",
)

# ---- Inputs -------------------------------------------------------------

DATAGEN = "@zstd//:datagen_cli"

# Lorem ipsum text (datagen's default), 1 MiB.
genrule(
    name = "lorem",
    outs = ["lorem.txt"],
    cmd = "$(execpath %s) -g1M -s1 > $@" % DATAGEN,
    tools = [DATAGEN],
    testonly = True,
)

# Real text: some of Goose's own samples.
genrule(
    name = "goose_text",
    srcs = [
        "@goose_src//:samples/01_tour.goose",
        "@goose_src//:samples/12_huffman.goose",
        "@goose_src//:samples/18_json.goose",
        "@goose_src//:samples/19_vm.goose",
        "@goose_src//:samples/30_mini_minecraft.goose",
        "@goose_src//:samples/31_mini_doom.goose",
        "@goose_src//:samples/data/alice.txt",
    ],
    outs = ["goose_text.txt"],
    cmd = "cat $(SRCS) > $@",
    testonly = True,
)

# A small, very repetitive text.
genrule(
    name = "honk",
    outs = ["honk.txt"],
    cmd = "for ((i = 0; i < 20000; i++)); do echo \"honk honk goose $$((i % 7))\"; done > $@",
    testonly = True,
)

# 300 KB of zeros: RLE blocks.
genrule(
    name = "zeros",
    outs = ["zeros.bin"],
    cmd = "head -c 300000 /dev/zero > $@",
    testonly = True,
)

# Incompressible noise: raw blocks and raw literals.
genrule(
    name = "noise",
    outs = ["noise.bin"],
    cmd = "$(execpath %s) -g20K -P0 -s2 > $@" % DATAGEN,
    tools = [DATAGEN],
    testonly = True,
)

# 3 MiB of half-compressible synthetic data: many blocks, long matches.
genrule(
    name = "mixed",
    outs = ["mixed.bin"],
    cmd = "$(execpath %s) -g3M -P50 -s3 > $@" % DATAGEN,
    tools = [DATAGEN],
    testonly = True,
)

genrule(
    name = "empty",
    outs = ["empty.bin"],
    cmd = ": > $@",
    testonly = True,
)

genrule(
    name = "one_byte",
    outs = ["one_byte.bin"],
    cmd = "printf g > $@",
    testonly = True,
)

INPUTS = {
    "empty": ":empty.bin",
    "goose_text": ":goose_text.txt",
    "honk": ":honk.txt",
    "lorem": ":lorem.txt",
    "mixed": ":mixed.bin",
    "noise": ":noise.bin",
    "one_byte": ":one_byte.bin",
    # A Doom level (Freedoom, from Goose's mini_doom sample): 4.8 MB of binary.
    "wad": "@goose_src//:samples/data/freedoom1-e1m1.wad",
    "zeros": ":zeros.bin",
}

# zstd flags, and whether zstd reads the input from a pipe (no content size).
SETTINGS = {
    "fast": ("--fast=5", False),
    "l1": ("-1", False),
    "l3": ("-3", False),
    "l19": ("-19", False),
    "long": ("-9 --long=27", False),
    "mt": ("-12 -T4", False),
    "nocheck": ("-3 --no-check", False),
    "stream": ("-6", True),
    "ultra": ("--ultra -22", False),
}

# //examples/goosezstd:<input>_<setting>_test
zstd_matrix(INPUTS, SETTINGS)

# ---- Several frames in one file -----------------------------------------

genrule(
    name = "multi_frame",
    srcs = [
        ":lorem_l1.zst",
        ":zeros_l19.zst",
        ":empty_l3.zst",
        ":noise_stream.zst",
        ":honk_nocheck.zst",
    ],
    outs = ["multi_frame.zst"],
    # A skippable frame (magic 0x184D2A5A, 5 bytes of payload) up front and
    # another in the middle.
    cmd = """
        skip() { printf '\\x5a\\x2a\\x4d\\x18\\x05\\x00\\x00\\x00honk!'; }
        srcs=($(SRCS))
        { skip; cat "$${srcs[@]:0:2}"; skip; cat "$${srcs[@]:2}"; } > $@
    """,
    testonly = True,
)

genrule(
    name = "multi_frame_original",
    srcs = [
        ":lorem.txt",
        ":zeros.bin",
        ":empty.bin",
        ":noise.bin",
        ":honk.txt",
    ],
    outs = ["multi_frame.orig"],
    cmd = "cat $(SRCS) > $@",
    testonly = True,
)

decompress_test(
    name = "multi_frame_test",
    compressed = ":multi_frame.zst",
    original = ":multi_frame.orig",
)

# ---- Damaged input is rejected ------------------------------------------

DAMAGED = [
    "bad_magic.zst",
    "bad_checksum.zst",
    "truncated.zst",
    "trailing_garbage.zst",
    "garbled.zst",
]

genrule(
    name = "damaged",
    srcs = [
        ":noise_l3.zst",
        ":lorem_l19.zst",
    ],
    outs = DAMAGED,
    cmd = """
        srcs=($(SRCS))
        raw=$${srcs[0]} huf=$${srcs[1]}
        out=$(RULEDIR)
        { printf '\\x29'; tail -c +2 $$raw; } > $$out/bad_magic.zst
        # noise is stored in raw blocks: change two content bytes, so only
        # the checksum notices.
        cp $$raw $$out/bad_checksum.zst
        printf '\\x00\\xff' | dd of=$$out/bad_checksum.zst bs=1 seek=1000 conv=notrunc status=none
        n=$$(stat -c %s $$huf)
        head -c $$((n / 2)) $$huf > $$out/truncated.zst
        { cat $$huf; printf 'goose'; } > $$out/trailing_garbage.zst
        # Overwrite bytes inside the entropy-coded data.
        cp $$huf $$out/garbled.zst
        printf 'GOOSEGOOSEGOOSE' | dd of=$$out/garbled.zst bs=1 seek=$$((n / 3)) conv=notrunc status=none
    """,
    testonly = True,
)

sh_test(
    name = "reject_test",
    size = "small",
    srcs = ["reject_test.sh"],
    args = ["$(rootpath :goosezstd)"] + ["$(rootpath :%s)" % f for f in DAMAGED],
    data = [":goosezstd"] + [":" + f for f in DAMAGED],
)

# ---- The libzstd demo ---------------------------------------------------

[decompress_test(
    name = "libzstd_demo_%s_test" % f,
    compressed = ":%s.zst" % f,
    decoder = ":libzstd_demo",
    original = INPUTS[f.rsplit("_", 1)[0]],
) for f in [
    "goose_text_l19",
    "wad_long",
]]

decompress_test(
    name = "libzstd_demo_multi_frame_test",
    compressed = ":multi_frame.zst",
    decoder = ":libzstd_demo",
    original = ":multi_frame.orig",
)

# ---- Throughput, against the real zstd ----------------------------------

genrule(
    name = "big",
    outs = ["big.bin"],
    cmd = "$(execpath %s) -g64M -P60 -s4 > $@" % DATAGEN,
    tools = [DATAGEN],
    testonly = True,
)

zstd_compress(
    name = "big_l3",
    src = ":big.bin",
    flags = "-3",
)

zstd_compress(
    name = "big_l19",
    src = ":big.bin",
    flags = "-19 -T0",
)

# Prints MB/s for both decoders to its log (bb view ... :bench_test).
sh_test(
    name = "bench_test",
    size = "medium",
    srcs = ["bench_test.sh"],
    args = [
        "$(rootpath :goosezstd)",
        "$(rootpath %s)" % ZSTD,
        "$(rootpath :big.bin)",
        "$(rootpath :big_l3.zst)",
        "$(rootpath :big_l19.zst)",
    ],
    data = [
        ":big.bin",
        ":big_l19.zst",
        ":big_l3.zst",
        ":goosezstd",
        ZSTD,
    ],
    tags = ["exclusive"],
)
