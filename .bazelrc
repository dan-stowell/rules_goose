# Development settings for this repository. Users of rules_goose do not
# inherit these.

# This repository builds with hermetic-llvm (registered in MODULE.bazel as a
# dev dependency), targeting static musl, so the Goose compiler (which runs in
# the exec configuration) and the test programs run on any x86-64 Linux,
# whatever its glibc. (On a host that is not x86-64 Linux this cross-compiles;
# run with the remote config.)
build:musl --platforms=@llvm//platforms:linux_x86_64_musl
build:musl --host_platform=@llvm//platforms:linux_x86_64_musl
# musl is linked statically only, so tests (cc_test defaults to dynamic) too.
build:musl --dynamic_mode=off
build --config=musl

test --test_output=errors

# BuildBuddy RBE.
build:remote --remote_executor=grpcs://buildbuddy.buildbuddy.io
build:remote --remote_cache=grpcs://buildbuddy.buildbuddy.io
build:remote --bes_backend=grpcs://buildbuddy.buildbuddy.io
build:remote --bes_results_url=https://buildbuddy.buildbuddy.io/invocation/
build:remote --remote_download_minimal
build:remote --jobs=100

try-import %workspace%/user.bazelrc
