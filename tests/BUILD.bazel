# Upstream Goose samples and tests, built with rules_goose and checked against
# upstream's expected output. The sources come straight from the pinned Goose
# tree (@goose_src, Apache-2.0, https://github.com/aardappel/goose).

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//goose:defs.bzl", "goose_test")
load(":sample_test.bzl", "sample_test")

# samples/01_tour.goose: the core language.
sample_test(
    name = "tour",
    expected = "@goose_src//:samples/expected/tour.out",
    main = "@goose_src//:samples/01_tour.goose",
)

# samples/07_sieve.goose: imports std and os from the standard library.
sample_test(
    name = "sieve",
    expected = "@goose_src//:samples/expected/sieve.out",
    main = "@goose_src//:samples/07_sieve.goose",
)

# samples/24_call_c.goose: extern fns implemented in a C header (c_hdrs).
sample_test(
    name = "call_c",
    c_hdrs = ["@goose_src//:samples/call_c.h"],
    expected = "@goose_src//:samples/expected/call_c.out",
    main = "@goose_src//:samples/24_call_c.goose",
)

# test/packages/pkg_basic.goose: path packages (import x from "./dir"), a
# package's module by name, and imports relative to the file and to the
# package root.
sample_test(
    name = "pkg_basic",
    expected = "@goose_src//:test/expected/pkg_basic.out",
    main = "@goose_src//:test/packages/pkg_basic.goose",
    srcs = [
        "@goose_src//:test/packages/pkgs/greet/extra.goose",
        "@goose_src//:test/packages/pkgs/greet/greet.goose",
        "@goose_src//:test/packages/pkgs/greet/helper.goose",
        "@goose_src//:test/packages/pkgs/greet/internal.goose",
        "@goose_src//:test/packages/pkgs/tools/tools.goose",
    ],
)

# The generated C names no build-specific path, so it is the same on every
# machine and in every sandbox (pkg_basic has path packages, which the
# compiler names by absolute path).
sh_test(
    name = "c_has_no_build_paths_test",
    srcs = ["c_has_no_build_paths.sh"],
    args = [
        "$(rootpath :pkg_basic.c)",
        "$(rootpath :call_c.c)",
        "$(rootpath :sieve.c)",
    ],
    data = [
        ":call_c.c",
        ":pkg_basic.c",
        ":sieve.c",
    ],
)

# goose_test: a Goose program that passes by exiting 0.
goose_test(
    name = "smoke_test",
    size = "small",
    main = "smoke_test.goose",
)
