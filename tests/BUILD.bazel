# Upstream Goose samples and tests, built with rules_goose and checked against
# upstream's expected output. The sources come straight from the pinned Goose
# tree (@goose_src, Apache-2.0, https://github.com/aardappel/goose).

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//goose:defs.bzl", "goose_binary", "goose_test")
load("//goose/private:goose.bzl", "goose_c")
load(":analysis_failure_test.bzl", "analysis_failure_test")
load(":sample_test.bzl", "sample_test")

# samples/01_tour.goose: the core language.
sample_test(
    name = "tour",
    expected = "@goose_src//:samples/expected/tour.out",
    main = "@goose_src//:samples/01_tour.goose",
)

# samples/07_sieve.goose: imports std and os from the standard library.
sample_test(
    name = "sieve",
    expected = "@goose_src//:samples/expected/sieve.out",
    main = "@goose_src//:samples/07_sieve.goose",
)

# samples/24_call_c.goose: extern fns implemented in a C header (c_hdrs).
sample_test(
    name = "call_c",
    c_hdrs = ["@goose_src//:samples/call_c.h"],
    expected = "@goose_src//:samples/expected/call_c.out",
    main = "@goose_src//:samples/24_call_c.goose",
)

# test/packages/pkg_basic.goose: path packages (import x from "./dir"), a
# package's module by name, and imports relative to the file and to the
# package root.
sample_test(
    name = "pkg_basic",
    expected = "@goose_src//:test/expected/pkg_basic.out",
    main = "@goose_src//:test/packages/pkg_basic.goose",
    srcs = [
        "@goose_src//:test/packages/pkgs/greet/extra.goose",
        "@goose_src//:test/packages/pkgs/greet/greet.goose",
        "@goose_src//:test/packages/pkgs/greet/helper.goose",
        "@goose_src//:test/packages/pkgs/greet/internal.goose",
        "@goose_src//:test/packages/pkgs/tools/tools.goose",
    ],
)

# The generated C names no build-specific path, so it is the same on every
# machine and in every sandbox (pkg_basic has path packages, which the
# compiler names by absolute path). native_test.c is read from another
# package, which its goose_test's visibility allows.
sh_test(
    name = "c_has_no_build_paths_test",
    srcs = ["c_has_no_build_paths.sh"],
    args = [
        "$(rootpath :pkg_basic.c)",
        "$(rootpath :call_c.c)",
        "$(rootpath :sieve.c)",
        "$(rootpath :oob_abort.c)",
        "$(rootpath //tests/app:native_test.c)",
    ],
    data = [
        ":call_c.c",
        ":oob_abort.c",
        ":pkg_basic.c",
        ":sieve.c",
        "//tests/app:native_test.c",
    ],
)

# A runtime abort in a path package names the file relative to the program.
# The compiler sees it by absolute path, which the rule rewrites.
goose_binary(
    name = "oob_abort",
    testonly = True,
    srcs = ["oob/oob.goose"],
    main = "oob_abort.goose",
)

sh_test(
    name = "oob_abort_test",
    size = "small",
    srcs = ["expect_failure.sh"],
    args = [
        "$(rootpath :oob_abort)",
        "'index 5 out of bounds (length 3) (oob/oob.goose:6)'",
    ],
    data = [":oob_abort"],
)

# goose_test: a Goose program that passes by exiting 0.
goose_test(
    name = "smoke_test",
    size = "small",
    main = "smoke_test.goose",
)

# A goose_test whose assert fails must fail. It is manual, so //... does not
# run it; fails_test_fails runs it and passes only if it fails.
goose_test(
    name = "fails_test",
    main = "fails.goose",
    tags = ["manual"],
)

sh_test(
    name = "fails_test_fails",
    size = "small",
    srcs = ["expect_failure.sh"],
    args = [
        "$(rootpath :fails_test)",
        "'assert failed (fails.goose:7)'",
    ],
    data = [":fails_test"],
)

# A staged file named like a c_hdrs header's include name is an error: the
# compiler would point the include at the staged copy. @goose_src's files are
# in its root package, so call_c.h in srcs is staged as samples/call_c.h, its
# include name.
goose_c(
    name = "hdr_in_srcs_at_root",
    srcs = ["@goose_src//:samples/call_c.h"],
    c_hdrs = ["@goose_src//:samples/call_c.h"],
    main = "@goose_src//:samples/24_call_c.goose",
    out = "hdr_in_srcs_at_root.c",
    tags = ["manual"],
)

analysis_failure_test(
    name = "hdr_in_srcs_at_root_test",
    message = "the include name of a c_hdrs header",
    target = ":hdr_in_srcs_at_root",
)
