# Overlay BUILD file for the Goose source tree (https://github.com/aardappel/goose),
# used by rules_goose's http_archive. It builds the compiler with plain rules_cc,
# reproducing what the upstream CMakeLists.txt and cmake/*.cmake produce, minus
# what transpiling with `-o` never needs:
#
#   - No builtin (blessed) packages are compiled in (GOOSE_BUILTIN_LIBS="").
#   - TinyCC is linked in (the compiler always references it), but its JIT
#     runtime directory (the tcc driver, libtcc1, staged headers) is not built,
#     so GOOSE_TCC_LIB_PATH points nowhere. `goose -o` never reaches it.
#
# Genrule commands use bash builtins only, which is all some remote executors
# (actiond) provide.
#
# Goose is Apache-2.0 licensed; TinyCC is LGPL-2.1 (third_party/tinycc/COPYING).

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

exports_files(glob(
    [
        "LICENSE",
        "samples/**",
        "test/**",
    ],
    allow_empty = True,
))

# The standard library, which every compile passes with --stdlib.
filegroup(
    name = "stdlib",
    srcs = glob(["stdlib/**"]),
)

# --- TinyCC (cmake/libtcc.cmake) ---------------------------------------------

genrule(
    name = "tcc_config_h",
    srcs = ["third_party/tinycc/VERSION"],
    outs = ["tcc_config/config.h"],
    cmd = select({
        "@platforms//os:linux": "LINUX=1 ",
        "//conditions:default": "LINUX= ",
    }) + select({
        "@platforms//cpu:aarch64": "ARCH=aarch64 ",
        "//conditions:default": "ARCH=x86_64 ",
    }) + """
read -r VERSION < $< || [ -n "$$VERSION" ]
{
  echo '/* Generated by rules_goose (after cmake/libtcc.cmake). */'
  echo "#define TCC_VERSION \\"$$VERSION\\""
  echo '#define CONFIG_TCC_PREDEFS 0'
  echo '#define CONFIG_TCC_BACKTRACE 0'
  echo '#define CONFIG_TCC_BCHECK 0'
  if [ -n "$$LINUX" ]; then echo "#define CONFIG_TRIPLET \\"$$ARCH-linux-gnu\\""; fi
} > $@
""",
)

cc_library(
    name = "tcc_config",
    hdrs = [":tcc_config_h"],
    strip_include_prefix = "tcc_config",
    visibility = ["//visibility:private"],
)

# Only the API header is exposed: TinyCC's directory holds a VERSION file and
# headers (elf.h, ...) that would shadow system and C++ headers.
cc_library(
    name = "libtcc_api",
    hdrs = ["third_party/tinycc/libtcc.h"],
    strip_include_prefix = "third_party/tinycc",
    visibility = ["//visibility:private"],
)

cc_library(
    name = "libtcc",
    # One translation unit (ONE_SOURCE): libtcc.c includes the rest.
    srcs = ["third_party/tinycc/libtcc.c"],
    copts = [
        "-std=gnu99",
        "-w",
    ],
    linkopts = [
        "-ldl",
        "-lm",
    ],
    local_defines = ["ONE_SOURCE=1"] + select({
        "@platforms//cpu:aarch64": ["TCC_TARGET_ARM64"],
        "//conditions:default": ["TCC_TARGET_X86_64"],
    }) + select({
        "@platforms//os:macos": ["TCC_TARGET_MACHO"],
        "@platforms//os:windows": ["TCC_TARGET_PE"],
        "//conditions:default": [],
    }),
    textual_hdrs = glob(
        [
            "third_party/tinycc/*.c",
            "third_party/tinycc/*.h",
            "third_party/tinycc/*.def",
        ],
        exclude = [
            "third_party/tinycc/libtcc.c",
            "third_party/tinycc/tcc.c",
            "third_party/tinycc/conftest.c",
        ],
    ),
    visibility = ["//visibility:private"],
    deps = [
        ":libtcc_api",
        ":tcc_config",
    ],
)

# --- the shader compiler behind embed_shader ---------------------------------

cc_library(
    name = "cute_spirv",
    hdrs = [
        "third_party/cute_spirv/ckit.h",
        "third_party/cute_spirv/cute_spirv.h",
    ],
    strip_include_prefix = "third_party/cute_spirv",
    visibility = ["//visibility:private"],
)

cc_library(
    name = "shaderc",
    srcs = ["src/shaderc.c"],
    hdrs = [
        "src/gfx_blob.h",
        "src/shaderc.h",
    ],
    # ckit.h uses typeof, a GNU extension before C23.
    copts = [
        "-std=gnu11",
        "-w",
    ],
    visibility = ["//visibility:private"],
    deps = [":cute_spirv"],
)

# --- builtin_packages.h (cmake/package.cmake, with no builtin packages) -------

genrule(
    name = "builtin_packages_h",
    srcs = ["src/blessed.txt"],
    outs = ["generated/builtin_packages.h"],
    cmd = """
{
  printf '// Generated by cmake/package.cmake: the blessed table and the packages compiled\\n'
  printf '// into this compiler. Do not edit.\\n#pragma once\\n\\nnamespace goose {\\n\\n'
  printf 'inline const char *blessed_table = R"GSBL('
  while IFS= read -r line || [ -n "$$line" ]; do printf '%s\\n' "$$line"; done < $<
  printf ')GSBL";\\n\\n'
  printf '\\ninline const BuiltinPackage builtin_packages[] = {\\n'
  printf '    { nullptr, nullptr, nullptr, nullptr },\\n};\\n\\n}  // namespace goose\\n'
} > $@
""",
)

cc_library(
    name = "builtin_packages",
    hdrs = [":builtin_packages_h"],
    strip_include_prefix = "generated",
    visibility = ["//visibility:private"],
)

cc_library(
    name = "subprocess",
    hdrs = ["third_party/subprocess/subprocess.h"],
    strip_include_prefix = "third_party/subprocess",
    visibility = ["//visibility:private"],
)

# --- the compiler ------------------------------------------------------------

cc_binary(
    name = "goose",
    srcs = [
        "src/main.cpp",
        "src/process.cpp",
        "src/progress.cpp",
    ] + glob(
        ["src/**/*.h"],
        exclude = [
            "src/shaderc.h",
            "src/gfx_blob.h",
        ],
    ),
    copts = [
        "-std=c++20",
        "-Wno-missing-field-initializers",
    ],
    linkopts = [
        "-pthread",
        "-ldl",
    ],
    local_defines = [
        # TinyCC's runtime directory, which only JIT mode reads; not built here.
        "GOOSE_TCC_LIB_PATH=\\\"/nonexistent/goose-tcclib\\\"",
    ],
    deps = [
        ":builtin_packages",
        ":libtcc",
        ":libtcc_api",
        ":shaderc",
        ":subprocess",
    ],
)
